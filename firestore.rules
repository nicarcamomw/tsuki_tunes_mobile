rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    // Optional string field no longer than max.
    function shortString(d, field, max) {
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= max);
    }

    // ── Schema validation ──
    //
    // Each collection lists the fields it may hold and the type of each one.
    // Only what a write adds or changes is checked: an older document
    // keeps fields from earlier versions (the web app wrote the same
    // documents) without blocking updates, but nothing outside the schema
    // can be written, and every written value has its type. Removing a
    // field is always fine.

    // The fields this write adds or changes.
    function written() {
      return resource == null
          ? request.resource.data.keys().toSet()
          : request.resource.data.diff(resource.data).addedKeys()
              .union(request.resource.data.diff(resource.data).changedKeys());
    }

    function only(allowed) {
      return written().hasOnly(allowed);
    }

    function isWritten(f) {
      return f in written();
    }

    // When written: a string up to max characters (or null when nullable).
    function wString(f, max, nullable) {
      let v = request.resource.data.get(f, null);
      return !isWritten(f)
          || (nullable && v == null)
          || (v is string && v.size() <= max);
    }

    // When written: a string of 1..max characters.
    function wName(f, max) {
      let v = request.resource.data.get(f, null);
      return !isWritten(f) || (v is string && v.size() > 0 && v.size() <= max);
    }

    // When written: a whole number in [0, max].
    function wCount(f, max) {
      let v = request.resource.data.get(f, null);
      return !isWritten(f) || (v is int && v >= 0 && v <= max);
    }

    function wTime(f) {
      return !isWritten(f) || request.resource.data.get(f, null) is timestamp;
    }

    // When written: the server's clock (FieldValue.serverTimestamp()).
    function wNow(f) {
      return !isWritten(f) || request.resource.data.get(f, null) == request.time;
    }

    function wList(f, max) {
      let v = request.resource.data.get(f, null);
      return !isWritten(f) || (v is list && v.size() <= max);
    }

    function wMap(f, max) {
      let v = request.resource.data.get(f, null);
      return !isWritten(f) || (v is map && v.size() <= max);
    }

    // When written, equals the document's id.
    function wId(f, id) {
      return !isWritten(f) || request.resource.data.get(f, null) == id;
    }

    // users/{uid}: profile basics, counters, masks and the rate-limit stamp.
    // stats and masks are merged into, so older keys inside them may stay:
    // only their size and the values the app writes are checked.
    function validUserDoc(d) {
      return d.keys().size() <= 40
          && only(['displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt',
                   'stats', 'masks', 'lastSubWrite'])
          && wString('displayName', 500, true)
          && wString('email', 500, true)
          && wString('photoURL', 2000, true)
          && wTime('createdAt')
          && wTime('lastLoginAt')
          && wMap('stats', 20)
          && (!isWritten('stats') || !('totalTracks' in d.stats)
              || (d.stats.totalTracks is int && d.stats.totalTracks >= 0))
          && wMap('masks', 10)
          && (!isWritten('masks') || !('unlocked' in d.masks)
              || (d.masks.unlocked is map && d.masks.unlocked.size() <= 200))
          && (!isWritten('masks') || !('equipped' in d.masks)
              || d.masks.equipped == null
              || (d.masks.equipped is string && d.masks.equipped.size() <= 40))
          // The level 100 choice: to become an ethereal being or not.
          && (!isWritten('masks') || !('choice' in d.masks) || d.masks.choice in ['ser', 'no'])
          // Progress backup: a few counters, the top artists' plays, plays
          // per music style and the counters of the newer masks.
          && (!isWritten('masks') || !('progress' in d.masks)
              || (d.masks.progress is map && d.masks.progress.size() <= 10
                  && d.masks.progress.get('artists', {}) is map
                  && d.masks.progress.get('artists', {}).size() <= 50
                  && d.masks.progress.get('styles', {}) is map
                  && d.masks.progress.get('styles', {}).size() <= 24
                  && d.masks.progress.get('c', {}) is map
                  && d.masks.progress.get('c', {}).size() <= 40));
    }

    // users/{uid}/listenedTracks/{trackId}
    function validListenedTrack(d, trackId) {
      return d.keys().size() <= 20
          && only(['trackId', 'title', 'artistName', 'albumTitle', 'albumId',
                   'coverUrl', 'previewUrl', 'duration', 'listenedAt', 'artists'])
          && wId('trackId', trackId)
          && wString('title', 500, false)
          && wString('artistName', 500, false)
          && wString('albumTitle', 500, false)
          && wString('albumId', 64, false)
          && wString('coverUrl', 2000, false)
          && wString('previewUrl', 2000, false)
          && wCount('duration', 86400)
          && wTime('listenedAt')
          && wList('artists', 20);
    }

    // users/{uid}/playlists/{playlistId}. Its songs can't be checked one by
    // one (rules have no loops): their number is.
    function validPlaylist(d) {
      return d.keys().size() <= 20
          && only(['name', 'tracks', 'createdAt', 'updatedAt'])
          && (resource != null || ('name' in d && 'tracks' in d))
          && wName('name', 100)
          && wList('tracks', 1000)
          && wTime('createdAt')
          && wNow('updatedAt');
    }

    // users/{uid}/followedArtists/{artistId}
    function validFollowedArtist(d, artistId) {
      return d.keys().size() <= 20
          && only(['id', 'name', 'pictureUrl', 'pictureSmall', 'pictureMedium',
                   'pictureBig', 'pictureXl', 'fansCount', 'albumsCount'])
          && wId('id', artistId)
          && wString('name', 500, false)
          && wString('pictureUrl', 2000, false)
          && wString('pictureSmall', 2000, true)
          && wString('pictureMedium', 2000, true)
          && wString('pictureBig', 2000, true)
          && wString('pictureXl', 2000, true)
          && wCount('fansCount', 1000000000)
          && wCount('albumsCount', 100000);
    }

    // users/{uid}/listenedDeletions/{trackId}: when the song was unmarked.
    function validDeletion(d) {
      return d.keys().hasOnly(['deletedAt']) && d.deletedAt is timestamp;
    }

    // users/{uid}/playDays/{yyyy-MM-dd}: the day's plays, merged into with
    // increments.
    function validPlayDay(d, day) {
      return d.keys().size() <= 10
          && only(['date', 'plays', 'hours', 'seconds', 'tracks', 'updatedAt'])
          && wId('date', day)
          && wMap('plays', 2000)
          && wMap('tracks', 2000)
          && wMap('hours', 24)
          && wCount('seconds', 86400 * 1000)
          && wTime('updatedAt');
    }

    // lastSubWrite can only ever be set to the time of the request (or left
    // as it is), so it can't be pushed back to dodge the rate limit.
    function stampUntouchedOrNow() {
      return !('lastSubWrite' in request.resource.data)
          || request.resource.data.lastSubWrite == request.time
          || (resource != null
              && 'lastSubWrite' in resource.data
              && request.resource.data.lastSubWrite == resource.data.lastSubWrite);
    }

    // Server-side write rate limiting: every subcollection write must come
    // in the same batch or transaction as a write that stamps the parent
    // user doc's lastSubWrite with the request time (getAfter sees the
    // result of the whole batch), and the previous stamp must be at least
    // 1 second old. A client that skips the stamp is rejected, so it can't
    // write faster than one batch per second.
    function notRateLimited(userId) {
      let after = getAfter(userPath(userId));
      return after != null
          && after.data.get('lastSubWrite', null) == request.time
          && (!exists(userPath(userId))
              || get(userPath(userId)).data.get('lastSubWrite', null) == null
              || request.time > get(userPath(userId)).data.lastSubWrite + duration.value(1, 's'));
    }

    // ── Bonds (Lazos) ──

    function socialPath(userId, col, id) {
      return /databases/$(database)/documents/users/$(userId)/$(col)/$(id);
    }

    function signedIn() {
      return request.auth != null;
    }

    // A request or a Bond: the other person's card (name, photo, mask) and
    // the server's time.
    function validBondCard(d) {
      return d.keys().hasOnly(['name', 'photoUrl', 'maskId', 'at'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && shortString(d, 'photoUrl', 2000)
          && shortString(d, 'maskId', 40)
          && d.at == request.time;
    }

    // The level 100 choice is made once: once there, it can't change (the
    // whole masks map can still go, when the account's data is deleted).
    function choiceKept() {
      return resource == null
          || !('masks' in resource.data)
          || !('choice' in resource.data.masks)
          || !('masks' in request.resource.data)
          || request.resource.data.masks.get('choice', null) == resource.data.masks.choice;
    }

    // Users can only read/write their own document. It can't be deleted from
    // the app: recreating it would reset the rate limit's stamp.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
          && validUserDoc(request.resource.data)
          && choiceKept()
          && stampUntouchedOrNow();
      allow delete: if false;

      // Listened tracks subcollection — per-user isolation + size + rate limit
      match /listenedTracks/{trackId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && validListenedTrack(request.resource.data, trackId)
            && notRateLimited(userId);
        allow delete: if isOwner(userId) && notRateLimited(userId);
      }

      // Playlists subcollection — per-user isolation + size limits + rate limit
      match /playlists/{playlistId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && validPlaylist(request.resource.data)
            && notRateLimited(userId);
        allow delete: if isOwner(userId) && notRateLimited(userId);
      }

      // Unmark log so other devices can apply deletions incrementally
      match /listenedDeletions/{trackId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && validDeletion(request.resource.data)
            && notRateLimited(userId);
        allow delete: if isOwner(userId) && notRateLimited(userId);
      }

      // Followed artists subcollection — per-user isolation + size + rate limit
      match /followedArtists/{artistId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && validFollowedArtist(request.resource.data, artistId)
            && notRateLimited(userId);
        allow delete: if isOwner(userId) && notRateLimited(userId);
      }

      // Bonds. The one who accepts a request writes both sides, while the
      // request still exists; either side can undo it.
      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow create: if friendId != userId
            && validBondCard(request.resource.data)
            && ((isOwner(userId) && exists(socialPath(userId, 'friendRequests', friendId)))
                || (signedIn() && request.auth.uid == friendId
                    && exists(socialPath(friendId, 'friendRequests', userId))));
        allow delete: if isOwner(userId) || (signedIn() && request.auth.uid == friendId);
      }

      // Requests others sent me: the sender writes it (once a second at
      // most, and not to someone already bonded); either side can remove it.
      match /friendRequests/{fromId} {
        allow read: if isOwner(userId);
        allow create: if signedIn() && request.auth.uid == fromId && fromId != userId
            && validBondCard(request.resource.data)
            && !exists(socialPath(userId, 'friends', fromId))
            && notRateLimited(fromId);
        allow delete: if isOwner(userId) || (signedIn() && request.auth.uid == fromId);
      }

      // The requests I sent, to see and cancel them; the receiver clears it
      // when answering.
      match /sentRequests/{toId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && toId != userId
            && validBondCard(request.resource.data)
            && notRateLimited(userId);
        allow delete: if isOwner(userId) || (signedIn() && request.auth.uid == toId);
      }

      // Daily play log, one doc per yyyy-MM-dd. No notRateLimited(): plays
      // made offline are flushed back-to-back on reconnect and would all be
      // rejected. One doc per day plus map size caps bound abuse instead.
      match /playDays/{day} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && validPlayDay(request.resource.data, day);
        allow delete: if isOwner(userId);
      }
    }

    // A non-negative whole number up to max.
    function count(v, max) {
      return v is int && v >= 0 && v <= max;
    }

    function validTopArtist(a) {
      return a is map
          && a.keys().hasOnly(['name', 'count', 'pictureUrl'])
          && a.name is string && a.name.size() > 0 && a.name.size() <= 200
          && count(a.count, 1000000)
          && shortString(a, 'pictureUrl', 2000);
    }

    // The public profile: exactly these fields, each checked, so nothing
    // private can end up readable by others.
    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'nameLower', 'photoUrl', 'maskId', 'public', 'stats', 'topArtists',
                               'tops', 'milestones', 'updatedAt'])
          && d.displayName is string && d.displayName.size() <= 60
          && shortString(d, 'nameLower', 60)
          && (!('tops' in d) || (d.tops is list && d.tops.size() <= 30))
          && (!('milestones' in d) || (d.milestones is list && d.milestones.size() <= 10))
          && shortString(d, 'photoUrl', 2000)
          && shortString(d, 'maskId', 40)
          && d.public is bool
          && d.stats is map
          && d.stats.keys().hasOnly(['tracks', 'albums', 'artists'])
          && count(d.stats.get('tracks', 0), 1000000)
          && count(d.stats.get('albums', 0), 1000000)
          && count(d.stats.get('artists', 0), 1000000)
          && d.topArtists is list && d.topArtists.size() <= 5
          && (d.topArtists.size() < 1 || validTopArtist(d.topArtists[0]))
          && (d.topArtists.size() < 2 || validTopArtist(d.topArtists[1]))
          && (d.topArtists.size() < 3 || validTopArtist(d.topArtists[2]))
          && (d.topArtists.size() < 4 || validTopArtist(d.topArtists[3]))
          && (d.topArtists.size() < 5 || validTopArtist(d.topArtists[4]))
          && d.updatedAt == request.time;
    }

    // Profiles: the owner writes theirs (at most every 10 seconds, to keep
    // within the free quota).
    match /profiles/{userId} {
      // Public: anyone reads it, and finds it by name. Private: only its
      // owner and their Bonds.
      allow read: if isOwner(userId)
          || (resource != null && resource.data.get('public', false) == true)
          || (signedIn() && exists(socialPath(userId, 'friends', request.auth.uid)));
      allow create: if isOwner(userId) && validProfile(request.resource.data);
      allow update: if isOwner(userId)
          && validProfile(request.resource.data)
          && request.time > resource.data.updatedAt + duration.value(10, 's');
      allow delete: if isOwner(userId);
    }

    // A Bearer at level 100 (their name, the name for their mask, their
    // choice) or at the legend. A job with the admin key tells the app's
    // keeper and marks it told; no client can read these.
    function validAscension(d) {
      return only(['name', 'maskName', 'level', 'eco', 'choice', 'legend', 'at'])
          && wString('name', 80, false)
          && wString('maskName', 60, false)
          && d.level == 100
          && d.eco is int && d.eco >= 0
          && (!isWritten('choice') || d.choice in ['ser', 'no'])
          && (!isWritten('legend') || d.legend == true)
          && d.at == request.time
          // The choice, once told, stays.
          && (resource == null || !('choice' in resource.data)
              || d.get('choice', null) == resource.data.choice);
    }

    // ── Collaborative playlists ──

    function validShared(d) {
      return d.keys().hasOnly(['name', 'owner', 'members', 'invited', 'lastInvited', 'names', 'tracks',
                               'updatedAt', 'updatedBy'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.members is list && d.members.size() <= 20
          && d.invited is list && d.invited.size() <= 20
          && d.names is map && d.names.size() <= 40
          && d.tracks is list && d.tracks.size() <= 500
          && d.updatedAt == request.time
          && d.updatedBy == request.auth.uid;
    }

    function sharedChangeAllowed() {
      let me = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let base = changed.hasOnly(['tracks', 'updatedAt', 'updatedBy']);
      return after.owner == before.owner && (
        // A member edits the songs.
        (me in before.members && base)
        // The owner renames, removes people, edits songs, and invites
        // Bonds, one at a time; nobody becomes a member without joining.
        || (me == before.owner
            && changed.hasOnly(['name', 'invited', 'lastInvited', 'members', 'tracks', 'updatedAt', 'updatedBy'])
            && me in after.members
            && before.members.toSet().hasAll(after.members.toSet())
            && (after.invited.toSet().difference(before.invited.toSet()).size() == 0
                || (after.invited.toSet().difference(before.invited.toSet()) == [after.lastInvited].toSet()
                    && exists(socialPath(me, 'friends', after.lastInvited)))))
        // An invited Bond joins: from invited to members, with their name.
        || (me in before.invited
            && changed.hasOnly(['invited', 'members', 'names', 'updatedAt', 'updatedBy'])
            && after.members.toSet() == before.members.toSet().union([me].toSet())
            && after.invited.toSet() == before.invited.toSet().difference([me].toSet())
            && after.names.diff(before.names).affectedKeys().hasOnly([me]))
        // An invited one declines.
        || (me in before.invited
            && changed.hasOnly(['invited', 'updatedAt', 'updatedBy'])
            && after.invited.toSet() == before.invited.toSet().difference([me].toSet()))
        // A member (not the owner) leaves.
        || (me in before.members && me != before.owner
            && changed.hasOnly(['members', 'updatedAt', 'updatedBy'])
            && after.members.toSet() == before.members.toSet().difference([me].toSet()))
      );
    }

    // Members and invited Bonds read it; the rules above say who changes
    // what; only the owner deletes it.
    match /sharedPlaylists/{id} {
      allow read: if signedIn()
          && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.invited);
      allow create: if signedIn()
          && validShared(request.resource.data)
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.invited.size() == 0
          && request.resource.data.names.keys().hasOnly([request.auth.uid]);
      allow update: if signedIn() && validShared(request.resource.data) && sharedChangeAllowed();
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    match /ascensions/{userId} {
      allow create, update: if isOwner(userId) && validAscension(request.resource.data);
      // Deleting the account deletes it too.
      allow delete: if isOwner(userId);
      allow read: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
