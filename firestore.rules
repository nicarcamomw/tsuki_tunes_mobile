rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Size limits only: the web app writes the same documents, so shapes are
    // not enforced field by field. Limits stop a buggy or abusive client from
    // writing documents near Firestore's 1 MiB cap.
    function validPlaylist(d) {
      return (!('name' in d) || (d.name is string && d.name.size() <= 100))
          && (!('tracks' in d) || (d.tracks is list && d.tracks.size() <= 1000));
    }

    // Server-side write rate limiting: subcollection writes must batch-update
    // the parent user doc's lastSubWrite timestamp. This function rejects
    // writes that arrive less than 1 second after the previous one.
    function notRateLimited(userId) {
      let userData = get(/databases/$(database)/documents/users/$(userId)).data;
      return !('lastSubWrite' in userData)
          || request.time > userData.lastSubWrite + duration.value(1, 's');
    }

    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Listened tracks subcollection — per-user isolation + rate limit
      match /listenedTracks/{trackId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && notRateLimited(userId);
      }

      // Playlists subcollection — per-user isolation + size limits + rate limit
      match /playlists/{playlistId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && validPlaylist(request.resource.data)
            && notRateLimited(userId);
        allow delete: if isOwner(userId) && notRateLimited(userId);
      }

      // Unmark log so other devices can apply deletions incrementally
      match /listenedDeletions/{trackId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && notRateLimited(userId);
      }

      // Followed artists subcollection — per-user isolation + rate limit
      match /followedArtists/{artistId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && notRateLimited(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
