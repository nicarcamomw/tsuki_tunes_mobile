# Copy to dev.env or prod.env and fill in your values.
# These files are loaded with --dart-define-from-file=config/<env>.env
#
# NEVER commit env files with real keys — they are gitignored.

# Optional, local testing only: Last.fm goes through the backend. Never in
# the published APK.
# LASTFM_API_KEY=your_lastfm_api_key_here
USE_EMULATORS=false
EMULATOR_HOST=127.0.0.1
BUILD_NUMBER=0
GIT_SHA=local
