name: Release APK

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  release-apk:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Install dependencies
        run: flutter pub get

      - name: Read app version
        id: version
        shell: bash
        run: |
          VERSION_RAW=$(grep -E '^version:' pubspec.yaml | head -n 1 | awk '{print $2}' | tr -d '"')
          VERSION="${VERSION_RAW%+*}"
          echo "version=$VERSION" >> "$GITHUB_OUTPUT"
          echo "tag=v$VERSION" >> "$GITHUB_OUTPUT"

      - name: Check if tag already exists
        id: tag_check
        shell: bash
        run: |
          TAG="${{ steps.version.outputs.tag }}"
          if git ls-remote --tags origin "$TAG" | grep -q "$TAG"; then
            echo "exists=true" >> "$GITHUB_OUTPUT"
            echo "La tag $TAG ya existe. No se creará un release nuevo."
          else
            echo "exists=false" >> "$GITHUB_OUTPUT"
            echo "La tag $TAG no existe. Se creará un release nuevo."
          fi

      - name: Build release APK
        if: steps.tag_check.outputs.exists != 'true'
        env:
          LASTFM_API_KEY: ${{ secrets.LASTFM_API_KEY }}
        run: >-
          flutter build apk --release
          --target-platform android-arm,android-arm64
          --dart-define=LASTFM_API_KEY="$LASTFM_API_KEY"

      - name: Upload APK as workflow artifact
        if: steps.tag_check.outputs.exists != 'true'
        uses: actions/upload-artifact@v4
        with:
          name: tsuki-tunes-apk-${{ steps.version.outputs.version }}
          path: build/app/outputs/flutter-apk/app-release.apk
          retention-days: 30

      - name: Create GitHub Release with APK
        if: steps.tag_check.outputs.exists != 'true'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.version.outputs.tag }}
          name: ${{ steps.version.outputs.tag }}
          files: build/app/outputs/flutter-apk/app-release.apk
          generate_release_notes: true
          fail_on_unmatched_files: true
