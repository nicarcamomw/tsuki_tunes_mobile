      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"uid\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"uid\", \"id\"));"
        }
      ]
    },
