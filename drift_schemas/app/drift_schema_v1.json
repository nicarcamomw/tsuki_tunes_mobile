          "sql": "CREATE TABLE IF NOT EXISTS \"followed_artists\" (\"uid\" TEXT NOT NULL, \"artist_id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"uid\", \"artist_id\"));"
