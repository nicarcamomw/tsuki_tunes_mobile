    {
      "name": "listened_tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"listened_tracks\" (\"uid\" TEXT NOT NULL, \"track_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"artist_name\" TEXT NOT NULL, \"album_title\" TEXT NOT NULL, \"album_id\" TEXT NOT NULL, \"cover_url\" TEXT NOT NULL, \"preview_url\" TEXT NOT NULL DEFAULT '', \"duration\" INTEGER NOT NULL, \"listened_at\" INTEGER NULL, PRIMARY KEY (\"uid\", \"track_id\"));"
        }
      ]
    },
