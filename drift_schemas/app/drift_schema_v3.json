  "fixed_sql": [
    {
      "name": "listened_tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"listened_tracks\" (\"uid\" TEXT NOT NULL, \"track_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"artist_name\" TEXT NOT NULL, \"album_title\" TEXT NOT NULL, \"album_id\" TEXT NOT NULL, \"cover_url\" TEXT NOT NULL, \"preview_url\" TEXT NOT NULL DEFAULT '', \"duration\" INTEGER NOT NULL, \"listened_at\" INTEGER NULL, \"artists\" TEXT NULL, \"sync_state\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"uid\", \"track_id\"));"
        }
      ]
    },
    {
      "name": "playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"uid\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"uid\", \"id\"));"
        }
      ]
    },
    {
      "name": "followed_artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"followed_artists\" (\"uid\" TEXT NOT NULL, \"artist_id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"uid\", \"artist_id\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"payload\" TEXT NOT NULL DEFAULT '{}', \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"last_error\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "listened_by_album",
