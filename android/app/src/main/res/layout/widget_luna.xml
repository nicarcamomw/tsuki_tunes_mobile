<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_luna_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/widget_luna_bg">

    <!-- Today's moon, drawn by its phase -->
    <ImageView
        android:id="@+id/img_moon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@null" />

    <!-- Moon phase name (Japanese) -->
    <TextView
        android:id="@+id/txt_moon_name_jp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="月"
        android:textColor="#FFFF6B9D"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Moon phase name (English) -->
    <TextView
        android:id="@+id/txt_moon_name_en"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Moon Phase"
        android:textColor="#99E5E5E5"
        android:textSize="10sp" />

    <!-- Divider line -->
    <View
        android:id="@+id/divider"
        android:layout_width="40dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#33FF6B9D" />

    <!-- Now playing section -->
    <LinearLayout
        android:id="@+id/now_playing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/txt_now_playing_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♪ now playing"
            android:textColor="#66E5E5E5"
            android:textSize="9sp"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/txt_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textColor="#FFE5E5E5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center" />

        <TextView
            android:id="@+id/txt_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="#99888888"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
