<?xml version="1.0" encoding="utf-8"?>
<!-- Every connection: HTTPS only, and only certificates from Android's own
     authorities (not ones a user or an app installed), which stops traffic
     being read through a proxy. The domains below say the same for the
     ones the app uses most. No certificate pinning: the services are other
     companies' (Google, Spotify, Deezer...), which change their certificates
     on their own schedule; a pin would cut every user off until an update.
     That includes Tsuki's own backend (Cloud Functions), served on Google's
     certificates; its requests prove they come from the app with App Check
     instead. Guarded by test/network_security_test.dart. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.deezer.com</domain>
        <domain includeSubdomains="true">accounts.spotify.com</domain>
        <domain includeSubdomains="true">api.spotify.com</domain>
        <domain includeSubdomains="true">ws.audioscrobbler.com</domain>
        <domain includeSubdomains="true">firestore.googleapis.com</domain>
        <domain includeSubdomains="true">securetoken.googleapis.com</domain>
        <domain includeSubdomains="true">cloudfunctions.net</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
