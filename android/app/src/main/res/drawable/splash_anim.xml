<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+'s animated splash: the mask's red glow lights up over
     700 ms (frames made from splash_logo by tool, webp). The first Flutter
     frame (LoadingScreen) starts with the glow the last frame ends with. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="true">
    <item android:drawable="@drawable/splash_glow_00" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_01" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_02" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_03" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_04" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_05" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_06" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_07" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_08" android:duration="70" />
    <item android:drawable="@drawable/splash_glow_09" android:duration="70" />
</animation-list>
